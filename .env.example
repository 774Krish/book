# Copy this file to `.env` and fill in the values.
# `.env` is git-ignored — never commit real keys.

# Where contact-form messages and new-subscriber notifications are delivered.
CONTACT_TO=you@example.com

# Resend API key — https://resend.com/api-keys
# Leave this blank to have emails printed to the terminal instead of sent.
# That is the easiest way to test the whole flow locally.
RESEND_API_KEY=

# The From address. `onboarding@resend.dev` works immediately, but Resend will
# only deliver it to the address that owns the account. Once you verify your
# own domain in Resend, change this to something like:
#   MAIL_FROM=BooksOnline <hello@booksonline.com>
MAIL_FROM=BooksOnline <onboarding@resend.dev>

# Port used by `npm run dev:api`. Only change it if 3001 is taken.
API_PORT=3001
